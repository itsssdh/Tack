# Everything that is about YOU and not about the code. Fill every REPLACE_ME before running ./release.sh.
# (A normal ./build_app.sh works with these unfilled; it is only for your own testing.)

# The app's name.
APP_NAME="Tack"

# A reverse-domain ID that you own, for example com.yourname.appname. Changing it later makes macOS ask everyone
# for their permissions again, so settle it before the first release.
BUNDLE_ID="com.itsssdh.tack"

VERSION="1.0.1"
BUILD="1"

# Your name, for the copyright line.
COPYRIGHT_HOLDER="itsssdh"

# Signing. Two ways:
#   A) With a paid Apple Developer Program membership (users see no warning):
#      SIGN_IDENTITY:  the exact name from `security find-identity -v -p codesigning`, like
#                      Developer ID Application: Your Name (TEAMID)
#      NOTARY_PROFILE: created once with
#                      xcrun notarytool store-credentials "tack-notary" --apple-id you@example.com --team-id TEAMID
#   B) Without one: set SIGN_IDENTITY="local" and NOTARY_PROFILE="none". The app is signed with your own certificate
#      (made once by ./build_app.sh; back it up) and users must click "Open Anyway" on first launch.
SIGN_IDENTITY="local"
NOTARY_PROFILE="none"
